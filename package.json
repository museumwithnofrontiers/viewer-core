    "vue-router": "^4.5.0 || ^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
