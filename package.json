{
  "name": "@museumwnf/viewer-core",
  "version": "2.23.0",
  "description": "Application engine for MWNF websites: turns a dataset.config.js into a mounted Vue application.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/museumwithnofrontiers/viewer-core.git"
  },
  "publishConfig": {
